# Skill-Verse Backend Configuration Template
# Copy this file to backend/.env or set these environment variables in your environment.

# Server Port (default: 8081)
PORT=8081

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillverse?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillverse

# Database Name (default: skillverse)
MONGODB_DATABASE=skillverse

# JWT Secret Key (HMAC-SHA512 requires at least 32 characters, preferably 64 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_12345

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:5173,http://localhost:3000

# Frontend Base URL (used in password reset emails)
APP_BASE_URL=http://localhost:8080

# SMTP Configuration for Password Reset Emails (Optional - prints reset links in console if empty)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=no-reply@skillverse.local
