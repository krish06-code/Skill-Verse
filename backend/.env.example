# Skill-Verse Backend Configuration Template
# Copy this file to backend/.env or export these environment variables before starting.

# Server Port (default: 8081)
PORT=8081

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillverse?retryWrites=true&w=majority
# IMPORTANT: If your username or password contains special characters (e.g. @, :, /, ?, #, %),
# they must be URL-encoded (for example, replace '@' with '%40', ':' with '%3A').
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillverse?retryWrites=true&w=majority

# Database Name (default: skillverse)
MONGODB_DATABASE=skillverse

# JWT Secret Key (HMAC-SHA512 requires at least 32 characters, preferably 64 characters)
# Generate a strong 64-byte random string (e.g. using openssl rand -hex 64 or PowerShell)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_replace_me

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:8080,http://localhost:5173,http://localhost:3000

# Frontend Base URL (used in password reset emails)
APP_BASE_URL=http://localhost:8080

# SMTP Configuration for Password Reset Emails (Optional - prints reset links in console if empty)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=no-reply@skillverse.local
